# Robinhood Chain — Sherhood fresh deploy (chain id 4663)
DEPLOYER_PRIVATE_KEY=
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Canonical RH infra — https://docs.robinhood.com/chain/contracts/
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
SWAP_ROUTER=0xcaf681a66d020601342297493863e78c959e5cb2

PREVRANDAO_DELAY_BLOCKS=2
PREVRANDAO_MAX_DELAY_BLOCKS=64
VRF_CALLBACK_GAS=2500000
WETH_USDG_POOL_FEE=500
ROUTER_FEE_BPS=50
CREATION_FEE=5000000000000000000

# Fee sink for TreasuryDirect (forwards USDG here)
TREASURY_FEE_WALLET=0xc24f7118f55d0643a82a1594cbcbb7484011a251

# Blockscout verify (optional — leave empty to skip auto-verify)
# Real key lives in contracts/.env (gitignored); deploy script overrides from there.
BLOCKSCOUT_API_KEY=

# Whitelisted RH stock tokens for baskets (only symbols with live addresses on chain 4663).
# Registered post-deploy via RhRegisterStocks.s.sol — sherhood-deploy.sh does this automatically.
